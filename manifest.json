{
  "manifest_version": 3,
  "name": "Vercel Usage Tracker & Badge",
  "version": "0.1.4",
  "description": "Unofficial Vercel usage tracker and toolbar badge: included credit, on-demand charges, cycle spend, and CDN usage.",
  "homepage_url": "https://github.com/zealot-network/vercel-usage-badge",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://vercel.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vercel Usage Tracker & Badge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
